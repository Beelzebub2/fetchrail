{
  "$schema": "../website/node_modules/wrangler/config-schema.json",
  "name": "fetchrail",
  "main": "worker.mjs",
  "account_id": "ceb32a583d11c6cc5b64455c2db4a174",
  "compatibility_date": "2026-10-09",
  "ratelimits": [
    {
      "name": "ANALYTICS_RATE_LIMITER",
      "namespace_id": "814215390227",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "assets": {
    "directory": "../website/public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/fonts/*",
      "!/styles.css",
      "!/theme.js",
      "!/app.js",
      "!/downloads.mjs",
      "!/release-feed.mjs",
      "!/download-ui.mjs",
      "!/favicon.svg",
      "!/og.jpg",
      "!/robots.txt",
      "!/sitemap.xml"
    ],
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "fetchrail.rrmtools.uk",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RELEASE_FEED",
        "class_name": "ReleaseFeed"
      },
      {
        "name": "ANALYTICS",
        "class_name": "AnalyticsStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "release-feed-v1",
      "new_sqlite_classes": [
        "ReleaseFeed"
      ]
    },
    {
      "tag": "analytics-v1",
      "new_sqlite_classes": [
        "AnalyticsStore"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  }
}
