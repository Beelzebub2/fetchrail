{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window, the download prompts and the setup window",
  "windows": [
    "main",
    "confirm-*",
    "setup"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-minimize",
    "core:window:allow-start-dragging",
    "dialog:default",
    "opener:default"
  ]
}
