{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fetchrail",
  "version": "0.6.3-local.6",
  "identifier": "com.rrmtools.braid",
  "build": {
    "beforeDevCommand": "npm run browser:build && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Fetchrail",
        "width": 1260,
        "height": 780,
        "minWidth": 940,
        "minHeight": 620,
        "center": true,
        "visible": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2NTg5N0FDQUFCQTQ5NTkKUldSWlNicXFySmRZWnA2bHFGdXdoYklwOCtDWW1FY0ppK1ZZNzVvT0lDckt6QXExM1VrODgwcXQK",
      "endpoints": [
        "https://github.com/Beelzebub2/fetchrail/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
