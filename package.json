{
  "name": "fetchrail",
  "private": true,
  "version": "0.5.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node browser-extension/build.mjs && tsc && vite build",
    "browser:build": "node browser-extension/build.mjs",
    "browser:host": "npm run build && cargo build --manifest-path src-tauri/Cargo.toml --release --bin fetchrail --features tauri/custom-protocol --locked",
    "browser:install": "node scripts/platform-command.mjs browser:install",
    "browser:uninstall": "node scripts/platform-command.mjs browser:uninstall",
    "browser:test": "node scripts/test-native-host.mjs",
    "browser:check": "node scripts/test-extension.mjs && node scripts/test-extension-routing.mjs && node scripts/test-browser-batch.mjs",
    "engine:test": "node scripts/test-downloads.mjs",
    "engine:bench": "node scripts/benchmark-downloads.mjs",
    "torrent:deps": "node scripts/platform-command.mjs torrent:deps",
    "torrent:test": "node scripts/test-torrents.mjs",
    "torrent:listeners": "node scripts/test-torrent-listeners.mjs",
    "torrent:ui": "node scripts/test-torrent-ui.mjs",
    "torrent:desktop": "node scripts/test-torrent-desktop.mjs",
    "torrent:bench": "node scripts/benchmark-torrents.mjs",
    "setup:test": "node scripts/test-setup.mjs",
    "release:check": "node scripts/check-release.mjs",
    "release:build": "cargo build --manifest-path src-tauri/Cargo.toml --release --bin fetchrail --features tauri/custom-protocol --locked",
    "release:package": "node scripts/platform-command.mjs release:package",
    "icons": "node scripts/make-icons.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "linux:deps": "bash scripts/linux-dependencies.sh",
    "linux:native": "bash scripts/build-torrent-deps.sh",
    "linux:build": "node scripts/release-notices.mjs && npm run tauri -- build --config src-tauri/tauri.linux.unsigned.conf.json && node scripts/package-linux.mjs --unsigned",
    "linux:package": "node scripts/package-linux.mjs",
    "linux:qualify": "node scripts/qualify-linux.mjs",
    "linux:desktop": "node scripts/test-linux-desktop.mjs",
    "linux:wayland": "bash scripts/test-linux-wayland.sh",
    "desktop:test": "node scripts/smoke-desktop.mjs",
    "release:test": "node scripts/test-release-aggregation.mjs && node scripts/test-release-downloads.mjs",
    "release:signatures": "node scripts/test-signatures.mjs",
    "website:sync-downloads": "node scripts/sync-website-downloads.mjs",
    "ui:test": "node scripts/test-download-progress.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "lucide-react": "^0.548.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
