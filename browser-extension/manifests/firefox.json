{
  "manifest_version": 3,
  "name": "Fetchrail Browser Integration",
  "version": "0.6.0",
  "description": "Send browser downloads to the Fetchrail download manager.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": [
    "activeTab",
    "alarms",
    "contextMenus",
    "downloads",
    "nativeMessaging",
    "scripting",
    "storage",
    "webRequest"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Fetchrail Download Companion",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" },
    "default_popup": "panel.html"
  },
  "options_ui": {
    "page": "panel.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "browser@braid.rrmtools.uk",
      "strict_min_version": "128.0"
    }
  }
}
